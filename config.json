{
  "model_name": "distilbert/distilbert-base-uncased",
  "model_revision": "main",
  "seed": 42,
  "label_threshold": 0.5,
  "train_size": 20000,
  "validation_size": 6000,
  "test_size": 10000,
  "max_length": 256,
  "batch_size": 16,
  "gradient_accumulation_steps": 2,
  "baseline_epochs": 10,
  "baseline_learning_rate": 0.001,
  "baseline_weight_decay": 0.01,
  "fine_tune_epochs": 3,
  "early_stopping_patience": 1,
  "warmup_ratio": 0.1,
  "head_learning_rate_multiplier": 5.0,
  "class_weighting": "balanced",
  "untuned": {
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "dropout": 0.1
  },
  "search": {
    "trials": 4,
    "learning_rate": [0.00001, 0.00003, 0.00005],
    "weight_decay": [0.0, 0.01, 0.1],
    "dropout": [0.1, 0.2]
  },
  "bootstrap_repetitions": 500,
  "lime_samples": 512,
  "lime_features": 10
}
